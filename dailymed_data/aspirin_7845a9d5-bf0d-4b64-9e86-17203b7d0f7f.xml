               <title>
                  <content styleCode="bold">Principal Display Panel</content>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Good <br/>
Neighbor <br/>
Pharmacy<sup>®</sup>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">NDC 46122-691-78</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Compare to<br/>
Bayer<sup>®</sup> Genuine<br/>
Aspirin active ingredient**</content>
                  </paragraph>
                  <paragraph>REGULAR STRENGTH</paragraph>
                  <paragraph>
