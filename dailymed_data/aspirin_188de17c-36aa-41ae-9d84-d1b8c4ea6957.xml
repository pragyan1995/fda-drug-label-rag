            <section ID="LINK_1fca6cdd-0f77-42ec-953e-aa4f33cd50aa">
               <id root="29c29762-02a8-4caa-99d3-a13c13066a03"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Active ingredient (in each tablet)</content>
                  </content>
               </title>
               <text>
                  <paragraph>Aspirin 325 mg (NSAID)*<br/>*nonsteroidal anti-inflammatory drug</paragraph>
               </text>
               <effectiveTime value="20260917"/>
            </section>
